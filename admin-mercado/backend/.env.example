# Copia este archivo como .env y llena tus datos. El archivo .env no se sube a GitHub.
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_merc

# Clave para firmar los tokens de sesión. Usa una cadena larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Twilio (mensajes de pago por vencer)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
